set_property(GLOBAL PROPERTY TUTORIAL_CAPTURE_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}")

function(add_tutorial_capture_target role)
    get_property(tool_directory GLOBAL PROPERTY TUTORIAL_CAPTURE_DIRECTORY)
    set(entry "capture_ui.cpp")
    if(role STREQUAL "controls_second")
        set(entry "capture_layout_control.cpp")
    elseif(role STREQUAL "controls_third")
        set(entry "capture_display_control.cpp")
    elseif(role STREQUAL "project_story")
        set(entry "capture_project_story.cpp")
    endif()
    add_executable(tutorial_capture_${role} EXCLUDE_FROM_ALL "${tool_directory}/${entry}")
    target_compile_definitions(tutorial_capture_${role} PRIVATE "TUTORIAL_CAPTURE_${role}" ENGINE_INTERFACE_STATIC)
    target_compile_options(tutorial_capture_${role} PRIVATE /utf-8 /EHsc /permissive- /bigobj)
    target_include_directories(tutorial_capture_${role} BEFORE PRIVATE
        "${CMAKE_SOURCE_DIR}/repo/sdk/engine_interface/src"
        "${CMAKE_SOURCE_DIR}/repo/sdk/engine_interface/src/easyvrui"
        "${CMAKE_SOURCE_DIR}/repo/sdk/engine_interface/third_party/json"
        "${CMAKE_SOURCE_DIR}/tests/ui_automation"
        "${CMAKE_BINARY_DIR}/embedded_languages"
    )
    target_link_libraries(tutorial_capture_${role} PRIVATE ui_automation_host)

    if(ARGC GREATER 1)
        set(application "${ARGV1}")
        get_target_property(directory ${application} SOURCE_DIR)
        get_target_property(source_list ${application} SOURCES)
        target_include_directories(tutorial_capture_${role} PRIVATE "${directory}" "${directory}/src")

        foreach(source IN LISTS source_list)
            if(source MATCHES "([.]cpp)$" AND NOT source MATCHES "(^|/)(main|[^/]*cli)[.]cpp$")
                cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE absolute)
                target_sources(tutorial_capture_${role} PRIVATE "${absolute}")
            endif()
        endforeach()
    endif()
endfunction()

function(add_tutorial_ime_capture_target role application)
    add_tutorial_capture_target(${role})
    get_target_property(directory ${application} SOURCE_DIR)
    target_include_directories(tutorial_capture_${role} PRIVATE "${directory}/src")
    foreach(source IN ITEMS candidate_window ${role}_candidate_ui preedit_label ime_language application_support)
        target_sources(tutorial_capture_${role} PRIVATE "${directory}/src/${source}.cpp")
    endforeach()
endfunction()

function(configure_tutorial_capture)
    if(NOT TARGET ui_automation_host)
        message(FATAL_ERROR "Configure the native workspace with EASYVRUI_BUILD_TESTS=ON to build the WARP capture tool.")
    endif()

    add_tutorial_capture_target(desktop easyvrui_desktop)
    target_link_libraries(tutorial_capture_desktop PRIVATE ole32 uuid windowscodecs)
    add_tutorial_capture_target(designer easyvrui_form_designer)
    add_tutorial_capture_target(file_manager easyvrui_file_manager)
    target_link_libraries(tutorial_capture_file_manager PRIVATE shell32 shlwapi user32 gdi32 ole32 uuid mpr)
    add_tutorial_capture_target(task_manager easyvrui_task_manager)
    add_tutorial_capture_target(demo easyvrui_demo_cpp)
    target_link_libraries(tutorial_capture_demo PRIVATE dxgi)
    add_tutorial_capture_target(keyboard easyvrui_layout)
    add_tutorial_capture_target(dialog)
    add_tutorial_ime_capture_target(pinyin easyvrui_pinyin_input)
    add_tutorial_ime_capture_target(japanese easyvrui_japanese_rime)
    add_tutorial_capture_target(controls)
    add_tutorial_capture_target(controls_second)
    add_tutorial_capture_target(controls_third)
    add_tutorial_capture_target(project_story)
    get_property(tool_directory GLOBAL PROPERTY TUTORIAL_CAPTURE_DIRECTORY)
    set(control_directory "${tool_directory}/../examples/guide/controls")
    set(basic_directory "${tool_directory}/../examples/basics")
    target_sources(tutorial_capture_project_story PRIVATE "${basic_directory}/03_first_window/cpp/main.cpp" "${basic_directory}/04_form_designer/cpp/main.cpp" "${basic_directory}/04_form_designer/cpp/quick_shout_window.cpp")
    foreach(name IN ITEMS window label button textbox)
        target_sources(tutorial_capture_controls PRIVATE "${control_directory}/window-and-text/${name}/cpp/main.cpp")
    endforeach()
    foreach(name IN ITEMS checkbox radiobutton progressbar)
        target_sources(tutorial_capture_controls PRIVATE "${control_directory}/selection-and-status/${name}/cpp/main.cpp")
    endforeach()
    foreach(name IN ITEMS slider numericupdown)
        target_sources(tutorial_capture_controls_second PRIVATE "${control_directory}/selection-and-status/${name}/cpp/main.cpp")
    endforeach()
    foreach(name IN ITEMS combobox listbox)
        target_sources(tutorial_capture_controls_second PRIVATE "${control_directory}/collection-and-data/${name}/cpp/main.cpp")
    endforeach()
    foreach(name IN ITEMS panel scrollpanel splitter tabcontrol)
        target_sources(tutorial_capture_controls_second PRIVATE "${control_directory}/layout-and-container/${name}/cpp/main.cpp")
    endforeach()
    foreach(name IN ITEMS treeview listview grid)
        target_sources(tutorial_capture_controls_third PRIVATE "${control_directory}/collection-and-data/${name}/cpp/main.cpp")
    endforeach()
    foreach(name IN ITEMS menubar toolbar image screen blank)
        target_sources(tutorial_capture_controls_third PRIVATE "${control_directory}/command-and-display/${name}/cpp/main.cpp")
    endforeach()
endfunction()

cmake_language(DEFER CALL configure_tutorial_capture)
